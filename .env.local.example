# ====================================================
# 공동 주크박스 환경 변수 설정 가이드
# 이 파일을 복사하여 .env.local 로 이름 변경 후 값을 채우세요
# ====================================================

# ----------------------------
# Google OAuth (NextAuth.js)
# ----------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URIs 에 아래 주소를 추가하세요:
#   http://localhost:3000/api/auth/callback/google      (로컬 개발)
#   https://your-domain.vercel.app/api/auth/callback/google  (프로덕션)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ----------------------------
# Google Refresh Token
# ----------------------------
# 관리자가 /admin 페이지에서 Google 로그인 후 발급된 토큰을 복사하세요.
# 이 토큰으로 서버가 팀원들의 곡 추가 요청을 YouTube API로 처리합니다.
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# ----------------------------
# YouTube Data API v3
# ----------------------------
# Google Cloud Console > APIs & Services > Credentials > API Keys
# YouTube Data API v3가 활성화되어 있어야 합니다.
YOUTUBE_API_KEY=your_youtube_api_key_here

# ----------------------------
# YouTube Playlist ID
# ----------------------------
# YouTube 플레이리스트 URL에서 추출:
# https://www.youtube.com/playlist?list=PLxxxxxxxxxx
#                                        ^^^^^^^^^^ 이 부분
YOUTUBE_PLAYLIST_ID=your_playlist_id_here

# ----------------------------
# NextAuth.js
# ----------------------------
# 임의의 랜덤 문자열 (최소 32자):
#   openssl rand -base64 32  명령으로 생성 가능
NEXTAUTH_SECRET=your_random_secret_here

# 개발 환경에서는 http://localhost:3000
# Vercel 배포 후에는 실제 도메인으로 변경
NEXTAUTH_URL=http://localhost:3000
