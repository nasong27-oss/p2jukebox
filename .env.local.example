# ====================================================
# 공동 주크박스 환경 변수 설정 가이드
# 이 파일을 복사하여 .env.local 로 이름 변경 후 값을 채우세요
# ====================================================

# ----------------------------
# Spotify OAuth (NextAuth.js)
# ----------------------------
# Spotify Developer Dashboard > My Apps > 앱 생성 후 확인
# Redirect URIs 에 아래 주소를 추가하세요:
#   http://localhost:3000/api/auth/callback/spotify      (로컬 개발)
#   https://your-domain.vercel.app/api/auth/callback/spotify  (프로덕션)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here

# ----------------------------
# Spotify Refresh Token
# ----------------------------
# 관리자가 /admin 페이지에서 Spotify 로그인 후 발급된 토큰을 복사하세요.
# 이 토큰으로 서버가 팀원들의 곡 추가 요청을 Spotify API로 처리합니다.
SPOTIFY_REFRESH_TOKEN=your_refresh_token_here

# ----------------------------
# Spotify Playlist ID
# ----------------------------
# Spotify 플레이리스트 URL에서 추출:
# https://open.spotify.com/playlist/37i9dQZEVXbxxxxxx
#                                    ^^^^^^^^^^^^^^^^ 이 부분
SPOTIFY_PLAYLIST_ID=your_playlist_id_here

# ----------------------------
# NextAuth.js
# ----------------------------
# 임의의 랜덤 문자열 (최소 32자):
#   openssl rand -base64 32  명령으로 생성 가능
NEXTAUTH_SECRET=your_random_secret_here

# 개발 환경에서는 http://localhost:3000
# Vercel 배포 후에는 실제 도메인으로 변경
NEXTAUTH_URL=http://localhost:3000
